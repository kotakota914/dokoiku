# ---- データの保存先 ----
# memory   : サーバー内メモリ＋ .data/ に保存（Supabase 不要。開発・デモ・テスト用）
# supabase : Supabase（Auth / PostgreSQL+PostGIS / Storage）
# 未指定なら、NEXT_PUBLIC_SUPABASE_URL があれば supabase、なければ memory
DATA_BACKEND=memory
# memory モードで .data/memory.json へ保存するか（off でサーバー再起動ごとに初期データへ戻る）
MEMORY_PERSIST=on

# ---- Supabase（DATA_BACKEND=supabase のとき必須） ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー専用。ブラウザへ出さない（api_usage・通報処理・退会・一時ファイル削除に使う）
SUPABASE_SERVICE_ROLE_KEY=

# ---- 外部サービス（未設定なら代替動作：直線距離による概算、自前DB検索のみ） ----
ORS_API_KEY=
NOMINATIM_USER_AGENT=dokoiko-dev (contact: you@example.com)
NOMINATIM_ENABLED=true

# ---- 通知・監視（任意） ----
NOTIFY_WEBHOOK_URL=
# Sentry は未導入（予約のみ。設定しても何も起きない。docs/setup.md 5 章「エラー監視」）
SENTRY_DSN=

# ---- その他 ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
