# ---- データの保存先 ----
# memory   : サーバー内メモリ＋ .data/ に保存（Supabase 不要。開発・デモ・テスト用）
# supabase : Supabase（Auth / PostgreSQL+PostGIS / Storage）
# 未指定なら、NEXT_PUBLIC_SUPABASE_URL があれば supabase、なければ memory
DATA_BACKEND=memory
# memory モードで .data/memory.json へ保存するか（off でサーバー再起動ごとに初期データへ戻る）
MEMORY_PERSIST=on

# ---- Supabase（DATA_BACKEND=supabase のとき必須） ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー専用。ブラウザへ出さない（api_usage・通報処理・退会・一時ファイル削除に使う）
SUPABASE_SERVICE_ROLE_KEY=

# ---- 外部サービス（未設定なら代替動作：直線距離による概算、自前DB検索のみ） ----
# 徒歩・車の移動時間（OpenRouteService）。未設定なら直線距離×1.3の概算
ORS_API_KEY=
# 公共交通の移動時間（Google Routes API computeRouteMatrix）。未設定なら 15km/h＋待ち10分の概算
GOOGLE_ROUTES_API_KEY=
# 「AIと相談」（Gemini）。未設定なら「AIと相談」は停止中（503 FEATURE_SUSPENDED）
GEMINI_API_KEY=
# 既定 gemini-2.5-flash
GEMINI_MODEL=
# true で外部 API（ORS / Google Routes / Nominatim / Gemini）を mock-data/external の記録済みの結果に置き換える（F-8-8）。無料枠は数えない
EXTERNAL_API_MOCK=
NOMINATIM_USER_AGENT=dokoiko-dev (contact: you@example.com)
NOMINATIM_ENABLED=true

# ---- 通知・監視（任意） ----
NOTIFY_WEBHOOK_URL=
# Sentry は未導入（予約のみ。設定しても何も起きない。docs/setup.md 5 章「エラー監視」）
SENTRY_DSN=

# ---- その他 ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
